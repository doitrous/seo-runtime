{
  "name": "@omary98/seo-runtime-express",
  "version": "0.1.2",
  "description": "seo-hub runtime for Express: routes, redirects, res.locals.seo, injectHead for SPA shells.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/omary98/seo-runtime.git", "directory": "packages/express" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": "./dist/index.js", "./package.json": "./package.json" },
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning src/*.test.ts"
  },
  "dependencies": { "@omary98/seo-runtime-core": "0.1.2" },
  "peerDependencies": { "express": ">=4" },
