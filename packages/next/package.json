{
  "name": "@doitrous/seo-runtime-next",
  "version": "0.1.0",
  "description": "seo-hub runtime for Next.js app router: metadata, sitemap, robots, redirects, article pages.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": "./dist/index.js", "./edge": "./dist/edge.js", "./package.json": "./package.json" },
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning src/*.test.ts"
  },
  "dependencies": { "@doitrous/seo-runtime-core": "0.1.0" },
  "peerDependencies": { "next": ">=16", "react": ">=18" },
  "devDependencies": { "@types/react": "^19.0.0", "react": "^19.0.0" }
}
